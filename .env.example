LLM_BASE_URL=http://localhost:11434/v1   # Ollama on your laptop
LLM_API_KEY=ollama                       # any text works for Ollama
LLM_MODEL=qwen3.5:4b
LLM_REASONING_EFFORT=none   # qwen3.5 thinks unless told not to; leave empty for models that reject it
EMBED_MODEL=qwen3-embedding:0.6b
SPEND_CAP_USD=5
